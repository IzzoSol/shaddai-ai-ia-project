# S.A.P. backend — environment template
#
# Copy to .env and fill in ONLY what you have. Every one of these is
# OPTIONAL: with none of them set the service runs, exposes read-only
# routes, and keeps every money-moving path closed.
#
# NEVER commit a filled-in .env. It is gitignored.

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
# NODE_ENV=production

# ── Auth ─────────────────────────────────────────────────────────────────
# Leave REQUIRE_AUTH unset for local work: anonymous requests are allowed and
# the service stays read-only. Set it to "true" to require a real identity.
# REQUIRE_AUTH=true
#
# Strong, random, >=16 chars. If unset, a RANDOM EPHEMERAL secret is
# generated per boot (tokens reset on every restart — loudly).
# JWT_SECRET=

# Admin token for /api/x402/pause and /api/x402/grant. Unset = those routes
# refuse to act.
# ADMIN_TOKEN=

# Comma-separated admin emails.
# ADMIN_EMAILS=

# ── Fee routing (the transparent policy) ─────────────────────────────────
# The policy is 40% tree fund / 40% $ASIMOV liquidity / 20% platform.
# Each slice is in BASIS POINTS and the three must sum to 10000.
# SAP_TREE_FUND_BPS=4000
# SAP_ASIMOV_LIQUIDITY_BPS=4000
# SAP_PLATFORM_BPS=2000

# x402 FEE ROUTING is OFF by default. Set to 1 only when you actually want
# fees allocated to the tree fund and the liquidity leg.
# SAP_X402_FEE_ROUTING=0

# ── Treegens ─────────────────────────────────────────────────────────────
# Where tree payments are settled. Unset = tree intents queue with
# destination:null and are NOT sent anywhere.
# TREEGENS_TREASURY_WALLET=

# The liquidity leg for $ASIMOV. A Raydium LaunchLab bonding-curve pool on
# Solana. Verify before use — a graduation moves the pool to a NEW address.
# ASIMOV_LIQUIDITY_POOL=2MhdCBPyHyRKoM5AVEfq1rbcTkCnMz8iWpuUCrjMJXUw
# ASIMOV_LIQUIDITY_VENUE=solana-amm

# ── Hyperliquid (READS are enough for the whole public surface) ──────────
# HYPERLIQUID_TESTNET=true
#
# TRADING IS GATED BEHIND FOUR KEYS and is not reachable from HTTP at all:
#   1. HYPERLIQUID_TRADING_ENABLED=true
#   2. HYPERLIQUID_SDK present
#   3. HYPERLIQUID_PRIVATE_KEY set
#   4. HYPERLIQUID_ACCOUNT_ADDRESS set
# Leave all four unset. No HTTP route can trade.
# HYPERLIQUID_TRADING_ENABLED=
# HYPERLIQUID_PRIVATE_KEY=
# HYPERLIQUID_ACCOUNT_ADDRESS=

# ── Optional storage ─────────────────────────────────────────────────────
# Without DATABASE_URL the economy service uses a local JSON file.
# DATABASE_URL=
# FIREBASE_SERVICE_ACCOUNT=
